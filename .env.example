# Optional override for the local whisper.cpp model path.
# Supports a concrete .bin path or shorthand like models/whisper/large-v3-turbo.
RECORDROUTE_WHISPER_MODEL=models/whisper/ggml-base.bin

# Optional override for the llama.cpp summary model.
# Existing local GGUF file paths use -m. Any other value is treated as a Hugging Face repo for -hf.
RECORDROUTE_LLAMA_MODEL=ggml-org/gemma-3-4b-it-GGUF

# Optional Hugging Face token for gated/private llama.cpp model downloads.
HF_TOKEN=
