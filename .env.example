# 개발/빌드 시 기본 입력은 이 레포 루트의 `.env`입니다.
# `setup`은 이 파일을 `package/.env`로 복사하고, 패키지 실행은 `package/.env`만 읽습니다.
# Windows 절대 경로는 `'C:\path\to\file'` 또는 `C:/path/to/file` 형식을 권장합니다.

# 런타임 루트를 명시적으로 고정하려면 사용합니다.
# 비워 두면 자동 감지합니다.
# RECORDROUTE_RUNTIME_ROOT=/absolute/path/to/recordroute-runtime

# macOS `run.sh` startup preflight 설정입니다.
# true 면 package/.env 기준으로 VPN 연결과 SMB 마운트를 선행하고, 실패 시 기동을 중단합니다.
# VPN 이름 대신 `scutil --nc list`에 보이는 UUID를 쓰는 편이 더 안정적입니다.
# 이 preflight는 저장 경로를 강제하지 않고, VPN/SMB 준비만 확인합니다.
# SMB URL은 반드시 share 이름까지 포함해야 합니다.
# SMB mount path는 share root(`/Volumes/ShareName`) 또는 그 하위 폴더를 가리킬 수 있습니다.
# RECORDROUTE_STARTUP_VPN_ENABLED=false
# RECORDROUTE_STARTUP_VPN_NAME=8489373B-112D-499E-978D-AA8522418550
# RECORDROUTE_STARTUP_SMB_URL=smb://user@nas.local/recordroute
# RECORDROUTE_STARTUP_SMB_MOUNT_PATH=/Volumes/recordroute

# 메타데이터 저장소 설정입니다.
# sqlite 또는 postgres 를 사용할 수 있으며, 기본값은 sqlite 입니다.
RECORDROUTE_METADATA_DRIVER=sqlite
RECORDROUTE_METADATA_SQLITE_PATH=db/index.sqlite3
# RECORDROUTE_METADATA_POSTGRES_URL=postgres://user:password@localhost:5432/recordroute

# 오디오 저장 경로 설정입니다.
# 상대 경로는 런타임 루트 기준으로 해석됩니다.
RECORDROUTE_AUDIO_ROOT=db/audio
RECORDROUTE_AUDIO_CACHE_ROOT=db/audio-cache
RECORDROUTE_AUDIO_SPOOL_ROOT=db/audio-spool

# category burst rotation 임계값입니다.
# 비어 있거나, 0이거나, 숫자가 아니면 기본값 100을 사용합니다.
RECORDROUTE_QUEUE_BURST_LIMIT=100

# whisper.cpp 모델 경로입니다.
# 구체적인 .bin 경로나 shorthand(models/whisper/large-v3-turbo)를 지원합니다.
RECORDROUTE_WHISPER_MODEL=models/whisper/ggml-base.bin

# whisper 기본 전사 언어입니다.
# 비워 두지 말고 언어 코드(예: ko, en) 또는 auto 를 사용합니다.
RECORDROUTE_WHISPER_LANGUAGE=ko

# 사전 다운로드된 whisper 모델 디렉터리에서 `ggml-<model>.bin`을 복사하려면 사용합니다.
# RECORDROUTE_WHISPER_MODEL_SOURCE_DIR=/absolute/path/to/whisper-models

# whisper 모델 다운로드 URL 템플릿을 커스터마이즈하려면 사용합니다.
# `{model}` 플레이스홀더가 반드시 포함되어야 합니다.
# RECORDROUTE_WHISPER_MODEL_URL_TEMPLATE=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-{model}.bin

# llama.cpp 요약 모델입니다.
# 기존 로컬 GGUF 파일이면 `-m`, 그 외 값은 Hugging Face repo(`-hf`)로 해석합니다.
RECORDROUTE_LLAMA_MODEL=ggml-org/gemma-3-4b-it-GGUF

# summary embedding 모델입니다.
# 기존 로컬 GGUF 파일이면 `-m`, 그 외 값은 Hugging Face repo(`-hf`)로 해석합니다.
RECORDROUTE_LLAMA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B-GGUF

# gated/private Hugging Face llama.cpp 모델 다운로드에 필요할 수 있습니다.
HF_TOKEN=
