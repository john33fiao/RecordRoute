{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Least-privilege capabilities for RecordRoute Tauri app",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        {
            "identifier": "fs:allow-app-read",
            "allow": [
                {
                    "path": "$APPDATA/recordroute/models/**"
                }
            ]
        },
        {
            "identifier": "fs:allow-app-write",
            "allow": [
                {
                    "path": "$APPDATA/recordroute/logs/**"
                },
                {
                    "path": "$APPDATA/recordroute/artifacts/**"
                }
            ]
        },
        {
            "identifier": "shell:allow-execute",
            "allow": [
                {
                    "name": "recordroute-orchestrator",
                    "cmd": "recordroute-orchestrator",
                    "sidecar": true,
                    "args": true
                }
            ]
        },
        {
            "identifier": "http:default",
            "allow": [
                {
                    "url": "http://127.0.0.1:*"
                }
            ]
        }
    ]
}