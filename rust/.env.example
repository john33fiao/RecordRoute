APP_BIND_ADDR=127.0.0.1:3000
APP_STORAGE_ROOT=./storage
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recordroute
FFMPEG_BIN=ffmpeg
WHISPER_BASE_URL=http://127.0.0.1:8080
LLAMA_SUMMARY_BASE_URL=http://127.0.0.1:8081
LLAMA_EMBED_BASE_URL=http://127.0.0.1:8082
WHISPER_MODEL=/models/ggml-base.bin
SUMMARY_MODEL=summary-model
EMBED_MODEL=embedding-model
SIDECAR_TIMEOUT_SECS=300
WORKER_POLL_INTERVAL_MS=1000
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_JOB_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECS=15
MAX_SEARCH_LIMIT=50
